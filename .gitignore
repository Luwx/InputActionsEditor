# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
skills-lock.json
.atom/
.build/
.buildlog/
.history
.svn/
.claude/
.agents/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/docs/

# Packaging: keep the spec, scripts and AppDir metadata tracked, but ignore
# the large build artifacts and staged trees they produce.
/packaging/stage/
/packaging/AppDir/
/packaging/*.rpm
/packaging/*.src.rpm
/packaging/*.deb
/packaging/*.tar.gz
/packaging/*.AppImage

# Local-only dev fixtures (large stress configs and generator)
/scripts/config.yaml
/scripts/stress_config.yaml
/scripts/stress_gen.py

# Generated Dart files in lib
/lib/**/*.g.dart
/lib/**/*.freezed.dart
/lib/**/*.gen.dart
/lib/**/*.gr.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
